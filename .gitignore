# Obsidian Git Sync: 仅同步笔记 & 核心配置
# 设备界面与状态
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace*.lock
.obsidian/app.json
.obsidian/hotkeys.json
.obsidian/graph.json
.obsidian/cache/
journal.db

# 插件：仅同步启用列表
.obsidian/plugins/*
!.obsidian/community-plugins.json
!.obsidian/core-plugins.json

# 主题：仅同步选择配置
.obsidian/themes/*
!.obsidian/appearance.json

# 回收站与备份
.trash/
.obsidian/backups/

# 系统/IDE临时文件
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
*.tmp

# 第三方文件
.claude/
CLAUDE.md
