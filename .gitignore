# ==============================================
# Obsidian 忽略规则
# ==============================================

# 1. 个人工作区布局
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# 2. 插件安装包、本地缓存
.obsidian/plugins/*

# 3. 主题安装包
.obsidian/themes/*

# 4. 本地缓存、回收站、临时文件
journal.db
.trash/
.obsidian/cache/

# 5. 系统/IDE 临时文件
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
*.tmp

# 6. Claude 缓存目录
.claude/

# ==============================================
# 以下文件被保留上传
# ==============================================
# .obsidian/app.json
# .obsidian/appearance.json
# .obsidian/community-plugins.json
# .obsidian/core-plugins.json
