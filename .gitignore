# Obsidian Git Sync: 同步核心配置，隔离设备私有文件
# 设备布局、运行状态
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/app.json
.obsidian/workspace*.lock
.obsidian/hotkeys.json

# 插件：仅同步配置，忽略本体
.obsidian/plugins/*
!.obsidian/community-plugins.json
!.obsidian/core-plugins.json

# 主题：仅同步选择配置，忽略主题文件
.obsidian/themes/*
!.obsidian/appearance.json

# 缓存、临时文件
.obsidian/cache/
.obsidian/graph.json
journal.db
.trash/

# 系统、IDE 临时文件
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
*.tmp

# 第三方文件
.claude/
CLAUDE.md
